# Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here

# WooCommerce
WOO_STORE_URL=https://your-store.com
WOO_CONSUMER_KEY=your_consumer_key
WOO_CONSUMER_SECRET=your_consumer_secret

# Server Basic Auth (если сайт защищен HTTP-авторизацией, например через тоннель)
WOO_SERVER_USER=your_server_user
WOO_SERVER_PASSWORD=your_server_password

# Опциональные параметры
LOG_LEVEL=INFO
CACHE_ENABLED=true